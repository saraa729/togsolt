# ExpoCraft backend production environment

# Runtime
NODE_ENV=production
PORT=4000
EXPOCRAFT_SEED=false
EXPOCRAFT_JOBS=true
COMMISSION_BPS=1200

# Public URLs
# FRONTEND_URL is accepted as an alias, but EXPOCRAFT_WEB_ORIGIN is preferred.
EXPOCRAFT_WEB_ORIGIN=https://expocraft.mn
FRONTEND_URL=https://expocraft.mn
EXPOCRAFT_PUBLIC_ORIGIN=https://api.expocraft.mn
BACKEND_URL=https://api.expocraft.mn
EXPOCRAFT_CORS_ORIGINS=https://expocraft.mn

# Security
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

# Database
# postgres writes the JSON-compatible runtime state into app_state and keeps
# normalized relational tables in sync for reporting/migration.
EXPOCRAFT_DB_PROVIDER=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/expocraft?schema=public
# Production олон instance дээр login lockout/rate-limit runtime state-г Redis-д хадгална.
# Жишээ: redis://default:PASSWORD@redis-host:6379/0 эсвэл rediss://...
REDIS_URL=
EXPOCRAFT_POSTGRES_RELATIONAL_SYNC=true
EXPOCRAFT_POSTGRES_RELATIONAL_SYNC_DELAY_MS=500

# Jobs
ESCROW_JOB_INTERVAL_MS=3600000
RECONCILIATION_JOB_INTERVAL_MS=86400000

# Payment mode
# manual: cart/escrow flow works without provider credentials.
# live: env:check requires Stripe/QPay keys below.
EXPOCRAFT_PAYMENT_MODE=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
QPAY_MERCHANT_ID=
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
QPAY_WEBHOOK_SECRET=

# Seller payout
# manual: admin records bank transaction reference after transfer.
# api: backend POSTs to EXPOCRAFT_BANK_API_URL/transfers with bearer token.
EXPOCRAFT_BANK_TRANSFER_MODE=manual
EXPOCRAFT_BANK_API_URL=
EXPOCRAFT_BANK_API_KEY=

# Google sign-in
# If empty, /auth/google returns 503 and frontend hides the button.
GOOGLE_CLIENT_ID=

# Email / password reset
# If SMTP_HOST is empty, reset links are logged/returned for development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ExpoCraft <no-reply@expocraft.mn>

# File storage
# local works for a single-server demo.
# r2/s3 use server-side AWS Signature V4 PUT, so the bucket can keep public write OFF.
# http/cloudinary expects upload URL + public base URL.
EXPOCRAFT_STORAGE_PROVIDER=local
EXPOCRAFT_DATA_DIR=./data
EXPOCRAFT_UPLOAD_DIR=./data/uploads
EXPOCRAFT_R2_ENDPOINT=
EXPOCRAFT_R2_BUCKET=
EXPOCRAFT_R2_REGION=auto
EXPOCRAFT_R2_ACCESS_KEY_ID=
EXPOCRAFT_R2_SECRET_ACCESS_KEY=
EXPOCRAFT_S3_ENDPOINT=
EXPOCRAFT_S3_BUCKET=
EXPOCRAFT_S3_REGION=ap-southeast-1
EXPOCRAFT_S3_ACCESS_KEY_ID=
EXPOCRAFT_S3_SECRET_ACCESS_KEY=
EXPOCRAFT_STORAGE_UPLOAD_URL=
EXPOCRAFT_STORAGE_PUBLIC_BASE_URL=
EXPOCRAFT_STORAGE_TOKEN=
EXPOCRAFT_VIRUS_SCAN_REQUIRED=false
EXPOCRAFT_VIRUS_SCAN_URL=
EXPOCRAFT_VIRUS_SCAN_TOKEN=

# Search
EXPOCRAFT_SEARCH_PROVIDER=local
EXPOCRAFT_SEARCH_URL=
EXPOCRAFT_SEARCH_KEY=

# Async/event providers
EXPOCRAFT_QUEUE_PROVIDER=local
RABBITMQ_URL=

# Optional production providers. If unset, demo-safe fallback logic is used.
EXPOCRAFT_CARRIER_API_URL=
EXPOCRAFT_CARRIER_API_KEY=
EXPOCRAFT_AI_SUGGEST_URL=
EXPOCRAFT_AI_API_KEY=
