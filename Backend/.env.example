NODE_ENV=production
PORT=4000
JWT_SECRET=change-me-long-random-secret
EXPOCRAFT_SEED=false
EXPOCRAFT_DB_PROVIDER=postgres
DATABASE_URL=postgres://expocraft:password@127.0.0.1:5432/expocraft
REDIS_URL=redis://127.0.0.1:6379
EXPOCRAFT_PUBLIC_ORIGIN=https://api.expocraft.mn
EXPOCRAFT_STORAGE_PROVIDER=s3
EXPOCRAFT_STORAGE_UPLOAD_URL=https://storage.example.com/expocraft
EXPOCRAFT_STORAGE_PUBLIC_BASE_URL=https://cdn.example.com/expocraft
EXPOCRAFT_STORAGE_TOKEN=change-me
EXPOCRAFT_SEARCH_PROVIDER=meilisearch
EXPOCRAFT_SEARCH_URL=https://search.example.com
EXPOCRAFT_SEARCH_KEY=change-me
EXPOCRAFT_BANK_API_URL=https://bank-api.example.com
EXPOCRAFT_BANK_API_KEY=change-me
ESCROW_JOB_INTERVAL_MS=3600000
RECONCILIATION_JOB_INTERVAL_MS=86400000

# Google нэвтрэлт. Тохируулаагүй бол /auth/google 503 буцаана (товч ч харагдахгүй).
GOOGLE_CLIENT_ID=
