{
  "name": "expocraft-backend",
  "version": "1.0.0",
  "description": "ExpoCraft marketplace backend for Mongolian craft sellers and local/international buyers.",
  "main": "app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node app.js",
    "dev": "EXPOCRAFT_SEED=true node app.js",
    "test": "node --test",
    "db:migrate": "node scripts/migrate-postgres.js up",
    "db:export": "node scripts/migrate-postgres.js export",
    "backup": "bash scripts/backup.sh",
    "db:relational": "node scripts/export-relational.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "marketplace",
    "mongolia",
    "handmade",
    "backend"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.13.1",
    "sequelize": "^6.33.0",
    "pg-hstore": "^2.3.4",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.0",
    "express-rate-limit": "^6.9.0",
    "joi": "^17.9.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.4",
    "axios": "^1.6.0",
    "nodemailer": "^6.9.4",
    "winston": "^3.12.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "eslint": "^8.57.0"
  }
}
