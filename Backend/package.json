{
  "name": "expocraft-backend",
  "version": "1.0.0",
  "description": "ExpoCraft marketplace backend for Mongolian craft sellers and local/international buyers.",
  "main": "dist/app.js",
  "type": "commonjs",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "dev": "npm run build && EXPOCRAFT_SEED=true node dist/app.js",
    "test": "npm run build && node --test \"dist/test/**/*.js\"",
    "env:check": "npm run build && NODE_ENV=production node dist/scripts/check-env.js",
    "production:readiness": "npm run build && node dist/scripts/production-readiness.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "npm run db:push && npm run db:import",
    "db:import": "npm run build && node dist/scripts/prisma-state.js import",
    "db:export": "npm run build && node dist/scripts/prisma-state.js export",
    "db:status": "npm run build && node dist/scripts/prisma-state.js status",
    "backup": "bash scripts/backup.sh",
    "backup:postgres": "bash scripts/backup-postgres.sh",
    "restore:postgres": "bash scripts/restore-postgres.sh",
    "smoke:monitoring": "npm run build && node dist/scripts/monitoring-smoke.js",
    "smoke:production": "npm run build && node dist/scripts/production-smoke.js",
    "smoke:providers": "npm run build && node dist/scripts/provider-config-smoke.js",
    "worker:queue": "npm run build && node dist/scripts/queue-worker.js",
    "db:relational": "npm run build && node dist/scripts/export-relational.js",
    "products:images": "npm run build && node dist/scripts/assign-product-images.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "marketplace",
    "mongolia",
    "handmade",
    "backend"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.9.0",
    "helmet": "^7.0.1",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.4",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.33.0",
    "sharp": "^0.32.4",
    "socket.io": "^4.8.3",
    "winston": "^3.12.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.0.1",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2"
  }
}
