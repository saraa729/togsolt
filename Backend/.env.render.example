# ExpoCraft backend production env for Render
#
# Render Blueprint нь DATABASE_URL/JWT_SECRET/REDIS_URL-г автоматаар үүсгэнэ.
# Доорх domain/env-үүдийг Render Dashboard дээр бөглөнө.

NODE_ENV=production
EXPOCRAFT_SEED=false
EXPOCRAFT_JOBS=true
EXPOCRAFT_DB_PROVIDER=postgres
EXPOCRAFT_POSTGRES_RELATIONAL_SYNC=true

EXPOCRAFT_WEB_ORIGIN=https://expocraft.mn
FRONTEND_URL=https://expocraft.mn
EXPOCRAFT_PUBLIC_ORIGIN=https://api.expocraft.mn
BACKEND_URL=https://api.expocraft.mn
EXPOCRAFT_CORS_ORIGINS=https://expocraft.mn,https://www.expocraft.mn

# Public demo үед manual байж болно. Real payment launch үед `live` болгоод
# Stripe/QPay secret-үүдийг бөглөнө.
EXPOCRAFT_PAYMENT_MODE=manual
EXPOCRAFT_BANK_TRANSFER_MODE=manual

# Public production upload-д local storage ашиглахгүй. Cloudflare R2/S3
# credentials авсны дараа `r2` болгож доорх R2 env-үүдийг бөглөнө.
EXPOCRAFT_STORAGE_PROVIDER=r2
EXPOCRAFT_SEARCH_PROVIDER=local
EXPOCRAFT_QUEUE_PROVIDER=local

GOOGLE_CLIENT_ID=727216094961-nmhhimemqnqopfe440u5d7rd53rpae83.apps.googleusercontent.com

# Live launch хийх үед дараахыг real утгаар бөглөнө.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
QPAY_MERCHANT_ID=
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
QPAY_WEBHOOK_SECRET=

EXPOCRAFT_R2_ENDPOINT=
EXPOCRAFT_R2_BUCKET=
EXPOCRAFT_R2_REGION=auto
EXPOCRAFT_R2_ACCESS_KEY_ID=
EXPOCRAFT_R2_SECRET_ACCESS_KEY=
EXPOCRAFT_STORAGE_PUBLIC_BASE_URL=
EXPOCRAFT_VIRUS_SCAN_REQUIRED=true
EXPOCRAFT_VIRUS_SCAN_URL=
EXPOCRAFT_VIRUS_SCAN_TOKEN=

EXPOCRAFT_CARRIER_API_URL=
EXPOCRAFT_CARRIER_API_KEY=
EXPOCRAFT_AI_SUGGEST_URL=
EXPOCRAFT_AI_API_KEY=

SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ExpoCraft <no-reply@expocraft.mn>
