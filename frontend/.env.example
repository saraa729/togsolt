# ExpoCraft frontend environment

# Browser-side API URL. Production дээр backend-ийн public origin-оор солино.
# Vercel production жишээ: https://api.expocraft.mn эсвэл Render URL.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-side API URL. Vercel/SSR дотор private/internal URL ашиглаж болно.
# Public backend URL ашиглавал Render/Vercel dashboard дээр ижил тавина.
API_URL=http://localhost:4000

# Google нэвтрэлтийн товч. Local demo дээр ./dev.sh энэ утгыг backend-ийн
# GOOGLE_CLIENT_ID руу автоматаар дамжуулна. Production дээр хоёр талд нь
# ижил Client ID-г env dashboard дээр тусад нь тавина.
# Хоосон орхивол app доторх public demo Client ID fallback болно.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=727216094961-nmhhimemqnqopfe440u5d7rd53rpae83.apps.googleusercontent.com

# LAN IP дээр Google OAuth ажиллахгүй тул Google товч дарахад энэ origin руу
# шилжинэ. Google Console дээр яг энэ origin-ийг бүртгэнэ.
NEXT_PUBLIC_GOOGLE_LOCAL_ORIGIN=http://localhost:3000

# sitemap.xml / robots.txt / canonical үндсэн хаяг
# Production жишээ: https://expocraft.mn
NEXT_PUBLIC_SITE_URL=http://localhost:3000
