# ExpoCraft frontend environment

# Browser-side API URL. Production дээр backend-ийн public origin-оор солино.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-side API URL. Vercel/SSR дотор private/internal URL ашиглаж болно.
API_URL=http://localhost:4000

# Google нэвтрэлтийн товч. Local demo дээр ./dev.sh энэ утгыг backend-ийн
# GOOGLE_CLIENT_ID руу автоматаар дамжуулна. Production дээр хоёр талд нь
# ижил Client ID-г env dashboard дээр тусад нь тавина.
# Хоосон бол товч харагдахгүй.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# sitemap.xml / robots.txt / canonical үндсэн хаяг
NEXT_PUBLIC_SITE_URL=http://localhost:3000
